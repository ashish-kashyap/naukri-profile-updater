# ===========================================================================
# Naukri Profile Auto-Updater Configuration
# ===========================================================================
# NEVER commit .env to version control

# --- Credentials (Required) ---
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password_here

# --- Resume File Upload (Optional) ---
# Path to your resume PDF/DOCX (leave empty if you only want to refresh the headline)
# Example: RESUME_PATH="C:/Users/your_username/Documents/resume.pdf"
RESUME_PATH=
# For GitHub Actions cloud automation (convert resume to base64 and store in secrets):
# RESUME_BASE64=

# --- Headline Variants (Optional) ---
# Script alternates between Variant A and Variant B daily (max 250 characters each)
# Leave blank to auto-generate variants by toggling a trailing period
# Example:
# HEADLINE_VARIANT_A=Software Engineer | Python | AWS | Open to Work
# HEADLINE_VARIANT_B=Software Engineer | Python | AWS | Open to Work.
HEADLINE_VARIANT_A=
HEADLINE_VARIANT_B=

# --- Email OTP Auto-Reader (for GitHub Actions cloud runner OTP challenges) ---
# If running in cloud and Naukri sends an email OTP, script reads it via IMAP:
# For Gmail: generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=
# Email address to check (leave empty to use NAUKRI_EMAIL):
EMAIL_USER=
# IMAP server host (auto-detected for @gmail.com, @outlook.com, @yahoo.com):
EMAIL_HOST=

# --- Execution & Anti-Bot Tuning ---
HEADLESS=true
ACTION_DELAY_MS=1500

# --- Production Reliability ---
# Number of automatic retry attempts before reporting failure
MAX_RETRIES=3
# Delay in seconds between retries (uses exponential backoff)
RETRY_DELAY_SEC=15
# Anti-bot random schedule jitter in seconds (0 = disabled, e.g. 60 = wait 5-60s)
RANDOM_JITTER_MAX_SEC=0
# Windows desktop toast notifications on success/failure
SEND_NOTIFICATIONS=true
